# Caddy main configuration file
# Global ACME and logging settings
# Service-specific configurations are imported from {{ caddy.config_dir }}/

{
  email {{ caddy.email }}

  # Global logging configuration - all access logs to structured JSON file
  log {
    output file /var/log/caddy/access.log {
      roll_size 100mb
      roll_keep 5
      roll_keep_for 720h
    }
    format json
  }
}

# Import all service-specific configurations
# Each service role (jupyterhub, rstudio, vscode, etc.) creates its own .conf file
import {{ caddy.config_dir }}/*.conf