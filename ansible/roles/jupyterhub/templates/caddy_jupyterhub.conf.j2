# JupyterHub reverse proxy configuration
# Deployed to /etc/caddy/conf.d/jupyterhub.conf by Caddy role import

{% if jupyterhub.install %}
{{ caddy.domain }} {
  # Access logging - all successful requests
  log {
    output file /var/log/caddy/jupyterhub-access.log {
      roll_size 50mb
      roll_keep 10
      roll_keep_for 720h
    }
    format json
  }

  # Error logging - failed requests and errors
  log error {
    output file /var/log/caddy/jupyterhub-error.log {
      roll_size 50mb
      roll_keep 5
      roll_keep_for 720h
    }
    format json
  }

  # Reverse proxy to JupyterHub on /jupyter path
  reverse_proxy /jupyter* localhost:{{ jupyterhub.service.port }} {
    # Preserve the original Host header for JupyterHub routing
    header_up Host {http.request.header.Host}
    # Forward the original client IP
    header_up X-Real-IP {http.request.remote.host}
    header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
    # Indicate the original scheme (HTTPS from Caddy perspective)
    header_up X-Forwarded-Proto https
    # Handle WebSocket upgrade properly (Caddy does this automatically)
    # but we ensure Connection and Upgrade headers are preserved when needed
  }
}
{% endif %}