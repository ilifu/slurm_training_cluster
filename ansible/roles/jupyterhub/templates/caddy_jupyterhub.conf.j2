# JupyterHub reverse proxy configuration
# Deployed to /etc/caddy/conf.d/jupyterhub.conf by Caddy role import

{% if jupyterhub.install %}
{{ caddy.domain }} {
  # Access logging - all successful requests
  log {
    output file /var/log/caddy/jupyterhub-access.log {
      roll_size 50mb
      roll_keep 10
      roll_keep_for 720h
    }
    format json
  }

  # Error logging - failed requests and errors
  log error {
    output file /var/log/caddy/jupyterhub-error.log {
      roll_size 50mb
      roll_keep 5
      roll_keep_for 720h
    }
    format json
  }

  # Reverse proxy to JupyterHub on /jupyter path
  reverse_proxy /jupyter* localhost:{{ jupyterhub.service.port }} {
    # Pass through important headers for proper proxying
    header_up X-Real-IP {remote_host}
    header_up X-Forwarded-For {remote_host}
    header_up X-Forwarded-Proto {scheme}
    header_up X-Forwarded-Host {host}
    header_up X-Script-Name /jupyter

    # WebSocket support for JupyterHub and Jupyter
    header_up Connection "upgrade"
    header_up Upgrade "websocket"
  }
}
{% endif %}