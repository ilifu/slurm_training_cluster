[Unit]
Description=JupyterHub with SlurmSpawner
After=network-online.target slurmd.service
Wants=network-online.target

[Service]
User={{ jupyterhub.jupyter_user }}
Group={{ jupyterhub.jupyter_group }}
WorkingDirectory={{ jupyterhub_data_dir }}

# Use the virtual environment
Environment="PATH={{ jupyterhub_python_venv }}/bin:/usr/local/bin:/usr/bin:/bin"
Environment="VIRTUAL_ENV={{ jupyterhub_python_venv }}"

# Start JupyterHub
ExecStart={{ jupyterhub_python_venv }}/bin/jupyterhub \
  --JupyterHub.config_file={{ jupyterhub_config_dir }}/jupyterhub_config.py \
  --JupyterHub.data_files_path={{ jupyterhub_python_venv }}/share/jupyterhub

# Restart on failure
Restart=on-failure
RestartSec=10s

# Allow graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

# Create log directory if it doesn't exist
ExecStartPre=/bin/mkdir -p /var/log/jupyterhub
ExecStartPre=/bin/chown {{ jupyterhub.jupyter_user }}:{{ jupyterhub.jupyter_group }} /var/log/jupyterhub
ExecStartPre=/bin/chmod 0755 /var/log/jupyterhub

# Logging - direct output to files with proper ownership
# Note: StandardOutput/StandardError with file: creates files as root,
# so we use a script to create files with correct ownership first
ExecStartPre=/bin/touch /var/log/jupyterhub/stdout /var/log/jupyterhub/stderr
ExecStartPre=/bin/chown {{ jupyterhub.jupyter_user }}:{{ jupyterhub.jupyter_group }} /var/log/jupyterhub/stdout /var/log/jupyterhub/stderr
ExecStartPre=/bin/chmod 0644 /var/log/jupyterhub/stdout /var/log/jupyterhub/stderr
StandardOutput=file:/var/log/jupyterhub/stdout
StandardError=file:/var/log/jupyterhub/stderr

[Install]
WantedBy=multi-user.target