# /etc/pam.d/common-auth - authentication common to all services
# This file is auto-generated by Ansible to prioritize SSSD for LDAP users
# while maintaining fallback to Unix auth for local users

# SSSD authentication (LDAP users) - tried first, success causes jump to permit
auth    [success=2 default=ignore]        pam_sss.so forward_pass

# Unix authentication (local users) - fallback after SSSD
auth    [success=1 default=ignore]        pam_unix.so nullok try_first_pass

# Deny access if both methods failed
auth    requisite                         pam_deny.so

# Permit access
auth    required                          pam_permit.so

# Optional capability management
auth    optional                          pam_cap.so